      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Verificar status 200\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "// Extraer el access_token y guardarlo automáticamente en la variable de entorno\r",
              "const response = pm.response.json();\r",
              "if (response.access_token) {\r",
              "    pm.environment.set(\"jwt_token\", response.access_token);\r",
              "    console.log(\"JWT token guardado en el entorno correctamente.\");\r",
              "}"
            ],
